# Gemini vía Vertex AI (créditos GCP). Autenticación: gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=tu-proyecto-gcp
GOOGLE_CLOUD_LOCATION=global
# Elegir el modelo Flash vigente: https://docs.cloud.google.com/vertex-ai/generative-ai/docs/learn/model-versions
GEMINI_MODEL=gemini-2.5-flash

# Carpeta donde se guardan datasets y resultados
WORKSPACE_DIR=workspace
