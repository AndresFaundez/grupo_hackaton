# Gemini vía Vertex AI (créditos GCP)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=estudi-ai-1c38
GOOGLE_CLOUD_LOCATION=global
# Ruta al JSON de la service account (guárdalo FUERA del repo). Si se omite, usa gcloud auth application-default login
GOOGLE_APPLICATION_CREDENTIALS=~/.config/grupo_hackaton/gcp-sa.json
# Modelos disponibles en el proyecto: gemini-3-flash-preview, gemini-2.5-flash
GEMINI_MODEL=gemini-3-flash-preview
# Solo Gemini 3 (minimal, low, medium, high). "low" ~2x más rápido con calidad equivalente
GEMINI_THINKING_LEVEL=low

# Carpeta donde se guardan datasets y resultados
WORKSPACE_DIR=workspace
